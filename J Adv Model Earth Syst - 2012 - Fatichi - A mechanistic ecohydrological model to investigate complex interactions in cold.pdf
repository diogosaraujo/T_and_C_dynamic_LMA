      <rdf:Description rdf:about="" xmlns:dc="http://purl.org/dc/elements/1.1/">
         <dc:format>application/pdf</dc:format>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">A mechanistic ecohydrological model to investigate complex interactions in cold and warm water-controlled environments: 2. Spatiotemporal analyses</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:creator>
            <rdf:Seq>
               <rdf:li>S. Fatichi, V. Y. Ivanov, E. Caporali</rdf:li>
            </rdf:Seq>
         </dc:creator>
         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">1804 Hydrology: Catchment; 1813 Hydrology: Eco-hydrology; 1836 Hydrology: Hydrological cycles and budgets (1218, 1655); 1847 Hydrology: Modeling (1952, 4316); 1863 Hydrology: Snow and ice (0736, 0738, 0776, 1827)</rdf:li>
            </rdf:Alt>
         </dc:description>
      </rdf:Description>
