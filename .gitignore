# Downloaded forcing data -- large, reproducible from the scripts, never committed.
preprocessing/data/
*.nc
*.grib

# Large model output / inputs that must not go to GitHub (100 MB hard limit).
T&C/Thanos_US_xRM/RES_US_xRM.mat

# Result folders pulled back from $MODEL_RUN on the cluster for local inspection,
# laid out as <STATION>/era5_land/{fixed_lma,dyn_lma}/. Each RES_*.mat is 300+ MB
# -- three times GitHub's hard limit -- and every one of them is reproducible by
# re-running the model, so none of this belongs in history.
/US-*/
RES_*.mat

# AmeriFlux BASE/BIF pulled back from the cluster for local analysis. The BASE
# half-hourly CSVs are hundreds of MB per station (US-Ha2 alone is 298 MB) and are
# re-downloadable with preprocessing/download_ameriflux.py.
/ameriflux/

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# CDS credentials -- never commit
.cdsapirc

# MATLAB
*.asv
*.autosave
slprj/

# PLSR predictor tables copied in for inspection -- 40+ MB each, and they live on
# the cluster under PLSR_inputs_pixel_climatology_DOY/LMA/. Never commit them.
preprocessing/LMA_ecoregion_no*.csv
preprocessing/ecoregion_no*.csv

# Reference papers -- open access, retrievable from the DOIs in
# preprocessing/PARAMETERS.md, and 13 MB is not worth carrying in git history.
*.pdf

# Analysis products downloaded from $TC_INPUT_DATA for inspection. They are
# regenerated by their submit scripts and live on the cluster, not in git.
/lma_vs_badm.csv
/badm_biomass.csv
/ecoregion_pairing_check.csv

# Fleet LMA-effect assessment pulled back from $TC_INPUT_DATA/lma_effect for
# inspection. Regenerated by slurm/submit_lma_effect.sh; the per-station JSONs
# are a cache of the RES files, not a source.
/lma_effect/
